# Copy this file to .env and fill in real values. Never commit .env — it's
# gitignored. This file lists variable NAMES only, no real secrets.

# Supabase Postgres connection strings. Required — every production data
# path (auth, sessions' user lookups, matches, matchmaking queue, wallet
# verification) reads/writes Postgres exclusively via src/lib/db/, backed
# by the Prisma models in prisma/schema.prisma.
#
# DATABASE_URL: the POOLED connection (Supavisor, port 6543) — used by the
# app at runtime (src/lib/db/client.ts). Dashboard: Project Settings ->
# Database -> Connection string -> "Transaction" pooler mode.
DATABASE_URL=
# DIRECT_URL: the DIRECT connection (port 5432) — used only by the Prisma
# CLI (validate/generate/migrate); Supavisor's pooler doesn't support the
# session features migrations need. Same page, "Direct connection".
DIRECT_URL=

# Supabase project URL and service_role key — server-only, used by
# scripts/supabase-storage-setup.ts and src/lib/storage/supabase-avatar-storage.ts
# for Storage operations (the "avatars" bucket). NEVER read from a
# "use client" file or exposed to the browser — this key bypasses Row
# Level Security entirely. Dashboard: Project Settings -> API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Secret used to sign session cookies (see src/lib/auth/session.ts). Falls
# back to an insecure dev-only default if unset — fine for local
# development, but you MUST set a real random value before deploying
# anywhere real. Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Solana Tracker (solanatracker.io) API key for ranked-match wallet PNL
# (see src/lib/game/solanatracker-client.ts). Server-only — never read
# from a "use client" file, so it's never sent to the browser. Required
# when MOCK_SOLANA_TRACKER=false. Free tier: get a key at
# https://www.solanatracker.io/account/data-api.
SOLANA_TRACKER_API_KEY=

# "true"  -> ranked-match PNL uses the deterministic MOCK provider
#            (src/lib/game/pnl-service.ts). Development only.
# "false" -> ranked-match PNL MUST come from the real Solana Tracker API
#            (SOLANA_TRACKER_API_KEY required). If the real call fails,
#            the ranked match is blocked rather than falling back to mock
#            PNL — see startMatch()/verifyMatchPnl() in match-service.ts.
# Any value other than the literal string "false" is treated as mock mode.
MOCK_SOLANA_TRACKER=true

# Stripe secret key — used server-only (src/lib/stripe/client.ts) to create
# Checkout Sessions, Billing Portal sessions, and to look up subscriptions.
# NEVER exposed to the browser. Use a Stripe TEST MODE key
# (sk_test_... or, preferred, a restricted key rk_test_...) during
# development — see the "Stripe test mode" section of the final report for
# exact Dashboard steps. Get it from https://dashboard.stripe.com/test/apikeys.
STRIPE_SECRET_KEY=

# Signing secret for the /api/stripe/webhook endpoint (see
# src/app/api/stripe/webhook/route.ts) — verifies that webhook requests
# genuinely came from Stripe before any subscription state is written.
# For local development, run `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# and use the whsec_... value it prints. In the Dashboard, create a webhook
# endpoint and reveal its signing secret instead.
STRIPE_WEBHOOK_SECRET=

# The Stripe Price id for the recurring $20/month CoinDuel Pro plan (see
# src/lib/billing/plans.ts). Created once via `npm run stripe:setup`
# (scripts/stripe-setup.ts), which prints the id to put here.
STRIPE_PRO_PRICE_ID=
